{
  "name": "ng-agent-docs",
  "version": "0.1.0",
  "description": "Generates compact, per-symbol API docs from an Angular library's JSDoc, so AI agents read only what they need instead of the .d.ts files.",
  "keywords": [
    "angular",
    "ng-packagr",
    "documentation",
    "jsdoc",
    "ai",
    "agents",
    "llm"
  ],
  "type": "module",
  "bin": {
    "ng-agent-docs": "dist/ng-agent-docs.mjs"
  },
  "files": [
    "dist/ng-agent-docs.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild ng-agent-docs.mts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/ng-agent-docs.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run test:unit && node test/snapshot.mts",
    "test:unit": "node --test test/unit.mts",
    "test:update": "node test/snapshot.mts --update",
    "test:dist": "npm run build && node test/snapshot.mts --bin dist/ng-agent-docs.mjs",
    "sync-fixtures": "node test/fixtures/sync-single-entry.mts",
    "prepack": "npm run build",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@angular/common": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.3"
  }
}
