#!/usr/bin/env node
/**
 * Generates agent-docs/ from an Angular library's sources and JSDoc: its public API, split into small
 * files for AI agents. Works with a single entry point and with ng-packagr secondary entry points.
 *
 *   agent-docs/index.md                    → compact catalog, grouped by entry point, one line per symbol
 *   agent-docs/api/<entry>/<Symbol>.md     → details of one symbol (primary entry point: api/<Symbol>.md)
 *
 * Run it right after the library build, the docs go into the built package:
 *   ng build my-lib && ng-agent-docs --root projects/my-lib --strict
 * Options, JSDoc tags and exit codes: see README.md.
 */
import { existsSync, mkdirSync, readdirSync, readFileSync, rmSync, statSync, writeFileSync } from 'node:fs';
import { dirname, join, posix, relative, resolve, sep } from 'node:path';
import { parseArgs } from 'node:util';
import {
  ArrowFunction,
  CallExpression,
  ClassDeclaration,
  Decorator,
  FunctionDeclaration,
  FunctionExpression,
  GetAccessorDeclaration,
  getCompilerOptionsFromTsConfig,
  MethodDeclaration,
  Node,
  ObjectLiteralExpression,
  Project,
  PropertyDeclaration,
  Scope,
  SetAccessorDeclaration,
  SyntaxKind,
  Type,
  TypeFormatFlags,
  VariableDeclaration,
} from 'ts-morph';

// =============================================================================
// Config — from the command line (see README.md for the options)
// =============================================================================
// Usage error: exit code 2, so it is never mistaken for incomplete docs (exit code 1 in --strict mode).
function fail(message: string): never {
  console.error(message);
  process.exit(2);
}

const { values: args } = (() => {
  try {
    return parseArgs({
      options: {
        root: { type: 'string' },
        tsconfig: { type: 'string' },
        out: { type: 'string' },
        note: { type: 'string', multiple: true, default: [] },
        strict: { type: 'boolean', default: false },
      },
    });
  } catch (e) {
    return fail((e as Error).message); // unknown option, missing value…
  }
})();
if (!args.root) fail('Missing --root <library folder>, e.g. --root projects/my-lib');
const LIB_ROOT = resolve(args.root);
const TSCONFIG = resolve(args.tsconfig ?? join(LIB_ROOT, 'tsconfig.lib.json')); // needed so types resolve
const NOTES = args.note;
const STRICT = args.strict;
const PKG_FILE = join(LIB_ROOT, 'package.json');
if (!existsSync(PKG_FILE)) fail(`No package.json in ${LIB_ROOT}: --root must be the library folder.`);
const PKG = JSON.parse(readFileSync(PKG_FILE, 'utf8')) as { name: string; version: string };
const DEST_DIR = ngPackageDest(); // read even with --out: never scanned for entry points
const OUT_DIR = args.out ? resolve(args.out) : join(builtPackageDir(), 'agent-docs'); // ⚠️ wiped on every run

// Folders never scanned for ng-package.json files. Absent from a library made by `ng generate library`,
// but --root may be the repository itself (standalone ng-packagr). Skipped by name: node_modules.
// By path: DEST_DIR and OUT_DIR, as an entry point may have the same folder name.
const SKIP_DIRS = new Set(['node_modules']);
const SKIP_PATHS = new Set([DEST_DIR, OUT_DIR]);

// Files the OS adds to a folder opened in a file manager. Ignored by the --out safety check.
const OS_FILES = new Set(['.DS_Store', 'Thumbs.db', 'desktop.ini']);

// ng-packagr's default when an ng-package.json has no `lib.entryFile`.
const DEFAULT_ENTRY_FILE = 'src/public_api.ts';

// Written in every index.md. Its presence proves a folder was generated by this script, so it can be wiped.
const GENERATED_MARKER = '> Generated by ng-agent-docs. Do not edit.';

// =============================================================================
// Data model
// =============================================================================
type Kind = 'component' | 'directive' | 'pipe' | 'service' | 'class' | 'interface' | 'type' | 'enum' | 'function' | 'const';

/** One ng-packagr entry point: what consumers import, and the file that defines its public API. */
interface EntryPoint {
  importPath: string; // '@acme/ui' (primary) or '@acme/ui/forms' (secondary)
  slug: string; // folder relative to the library root: '' (primary) or 'forms'
  dir: string;
  file: string; // absolute path of the entry file
  description?: string | undefined; // from @packageDocumentation
}

/** Content of a symbol's JSDoc block, including our custom tags. */
interface Doc {
  description?: string | undefined;
  usage: string[]; // when to use it (one @usage tag per case)
  avoid: string[]; // when NOT to use it, and what to use instead
  replacedBy?: string | undefined; // newer equivalent to prefer in new code (legacy library)
  replaces: string[]; // older elements this one replaces, e.g. mat-form-field (modern library)
  deprecated?: string | undefined;
  examples: string[];
}

/** One template binding: input, model or output. */
interface Member {
  name: string; // name used in templates (the alias, if any)
  type: string; // type of the value, as the consumer sees it
  required: boolean;
  default?: string | undefined;
  transform?: string | undefined; // e.g. booleanAttribute: the input also accepts what it converts
  description?: string | undefined;
  deprecated?: string | undefined;
  inheritedFrom?: ClassDeclaration | undefined; // base class that declares it, for an inherited binding
  fromHostDirective?: ClassDeclaration | undefined; // host directive that provides it, for an exposed binding
  // Internal, not rendered: used to merge and re-type inherited bindings.
  prop: string; // class member name (the template name may be an alias)
  wrapped: boolean; // `type` was unwrapped from InputSignal<T>, ModelSignal<T>, EventEmitter<T>…
}

/** Every template binding of a class, by kind. */
interface Bindings {
  inputs: Member[];
  outputs: Member[];
  models: Member[];
}

/** Where a symbol is documented, and how it is imported. */
interface Context {
  ep: EntryPoint; // the entry point that owns the symbol
  alsoFrom: { importPath: string; name: string }[]; // its other exports: by other entry points, or renamed
  page: string; // its page, relative to OUT_DIR
}

/** One documented symbol, ready to be written to disk and listed in the index. */
interface Entry {
  name: string;
  kind: Kind;
  doc: Doc;
  ep: EntryPoint;
  page: string; // relative to OUT_DIR
  selector?: string | undefined;
  pipeName?: string | undefined;
  markdown: string;
}

// =============================================================================
// Constants
// =============================================================================
// Angular decorator → kind of symbol. Classes without one of these are documented as plain classes.
const NG_DECORATORS: Record<string, Kind> = { Component: 'component', Directive: 'directive', Pipe: 'pipe', Injectable: 'service' };

// Signal-based binding functions recognized in property initializers.
const SIGNAL_FNS = new Set(['input', 'model', 'output', 'outputFromObservable']);

// Lifecycle hooks are public but are not part of the API a consumer calls.
const LIFECYCLE = /^ng(OnInit|OnChanges|DoCheck|AfterContentInit|AfterContentChecked|AfterViewInit|AfterViewChecked|OnDestroy)$/;

// Print types as the consumer sees them: keep alias names (ButtonVariant, not the union), never truncate.
const TYPE_FORMAT = TypeFormatFlags.UseAliasDefinedOutsideCurrentScope | TypeFormatFlags.NoTruncation;

// Missing documentation found during the run. Printed at the end; fails the run in --strict mode.
const warnings: string[] = [];

// =============================================================================
// Generic helpers
// =============================================================================
const typeText = (t: Type, at: Node) => t.getText(at, TYPE_FORMAT);

// Collapse a multi-line text (a default value, a description) to one line, for a list item.
const oneLine = (s = '') => s.replace(/\s+/g, ' ').trim();

// Inline code that survives backticks in its content (template literals): `x`, or `` a`b `` when needed.
const code = (s: string) => {
  const text = oneLine(s);
  const longestRun = Math.max(0, ...(text.match(/`+/g) ?? []).map((run) => run.length));
  const fence = '`'.repeat(longestRun + 1);
  return longestRun ? `${fence} ${text} ${fence}` : `${fence}${text}${fence}`;
};

// First paragraph of a description, on one line, for the one-line lists of a page. It can be wrapped over
// several lines, and ends at a blank line, a list, a heading, a quote, a table or a code fence.
const firstParagraph = (s = '') => {
  const lines = s.trim().split('\n');
  const end = lines.findIndex((l, i) => i > 0 && /^\s*($|[-*+>#|]|\d+\.\s|```)/.test(l));
  return oneLine(lines.slice(0, end < 0 ? undefined : end).join(' '));
};

// First sentence of a description, for the index: it ends at `.`, `!` or `?` followed by a capital letter
// (`e.g. this` does not end it), or with the first paragraph.
const summary = (s = '') => {
  const paragraph = firstParagraph(s);
  return /^.*?[.!?](?=\s+\p{Lu})/u.exec(paragraph)?.[0] ?? paragraph;
};
const codeBlock = (lang: string, s: string) => '```' + lang + '\n' + s.trim() + '\n```';
const toPosix = (p: string) => p.split(sep).join('/');
// `dir` itself, or anything below it. Works for a root folder too (`/` or `C:\`).
const isInside = (file: string, dir: string) => file === dir || file.startsWith(dir.endsWith(sep) ? dir : dir + sep);

// Sort order of the index. A fixed locale: `localeCompare()` alone follows the machine's locale,
// so the output (and the snapshot test) could change from one machine to another.
const byName = new Intl.Collator('en').compare;

// Value of a string literal node ('x', "x" or `x`), otherwise undefined.
const str = (n?: Node) =>
  n && (Node.isStringLiteral(n) || Node.isNoSubstitutionTemplateLiteral(n)) ? n.getLiteralText() : undefined;

// Initializer of property `name` in an object literal, e.g. `selector` in `{ selector: 'lx-button' }`.
const propOf = (obj: ObjectLiteralExpression | undefined, name: string) => {
  const p = obj?.getProperty(name);
  return p && Node.isPropertyAssignment(p) ? p.getInitializer() : undefined;
};

// Metadata object passed to a decorator: @Component({ ... }) → { ... }
const metadata = (d?: Decorator) => {
  const arg = d?.getArguments()[0];
  return arg && Node.isObjectLiteralExpression(arg) ? arg : undefined;
};

// The Angular decorator of a class (@Component, @Directive, @Pipe, @Injectable), if any.
const ngDecorator = (cls: ClassDeclaration) => cls.getDecorators().find((d) => d.getName() in NG_DECORATORS);

// Public, non-static, not #private. Used to filter members of services and classes.
const isPublic = (m: PropertyDeclaration | MethodDeclaration | GetAccessorDeclaration) =>
  m.getScope() === Scope.Public && !m.isStatic() && !m.getName().startsWith('#');

// Markdown file of a symbol, relative to OUT_DIR: api/<entry slug>/<Symbol>.md
// (unless its name differs from another one only by case: see `pageOf`).
const docPath = (e: { name: string; ep: EntryPoint }) => ['api', e.ep.slug, `${e.name}.md`].filter(Boolean).join('/');

// =============================================================================
// Default output folder: inside the built package
// =============================================================================
/**
 * Folder of the built package: the `dest` of the library's ng-package.json, relative to that file
 * (ng-packagr's default: `dist`). Undefined without an ng-package.json in the library folder.
 * Nothing is checked: with --out, the library does not have to be built.
 *
 * Called while the config is read, before the helpers below are defined, like builtPackageDir():
 * both only use node: imports and fail().
 */
function ngPackageDest(): string | undefined {
  const ngPackage = join(LIB_ROOT, 'ng-package.json');
  if (!existsSync(ngPackage)) return undefined;
  const config = JSON.parse(readFileSync(ngPackage, 'utf8')) as { dest?: string };
  return resolve(LIB_ROOT, config.dest ?? 'dist');
}

/**
 * DEST_DIR, where agent-docs/ goes when --out is not given.
 *
 * ng-packagr empties `dest` at the start of every build, so the docs must be generated after it.
 * Exits with code 2 if there is no ng-package.json, if the package has not been built, or if `dest`
 * holds another package.
 */
function builtPackageDir(): string {
  const dest = DEST_DIR ?? fail(`No ng-package.json in ${LIB_ROOT}: pass --out <dir>.`);
  const builtPkg = join(dest, 'package.json');
  if (!existsSync(builtPkg)) {
    fail(`${builtPkg} not found: build the library first (ng build), agent-docs/ goes into the built package.`);
  }
  const { name } = JSON.parse(readFileSync(builtPkg, 'utf8')) as { name?: string };
  if (name !== PKG.name) fail(`${builtPkg} is the package ${name}, not ${PKG.name}: check "dest" in ${join(LIB_ROOT, 'ng-package.json')}.`);
  return dest;
}

// =============================================================================
// Output folder safety
// =============================================================================
/**
 * OUT_DIR is deleted on every run, so a wrong --out (`.`, the library folder, `src/`) would delete
 * source code. Exits with code 2, before anything is read or deleted, unless OUT_DIR is safe to wipe:
 * it does not exist, is empty, or holds only the output of a previous run (index.md with GENERATED_MARKER,
 * and the .md pages under api/). The library folder is also checked by path, for a clearer message.
 */
function checkOutDir(): void {
  const generatedBefore = () => {
    const index = join(OUT_DIR, 'index.md');
    return existsSync(index) && readFileSync(index, 'utf8').includes(GENERATED_MARKER);
  };
  // What a previous run did not write, relative to OUT_DIR. A folder is listed, not its content.
  const notGenerated = (dir = OUT_DIR): string[] =>
    readdirSync(dir, { withFileTypes: true }).flatMap((d) => {
      const path = toPosix(relative(OUT_DIR, join(dir, d.name)));
      const underApi = path === 'api' || path.startsWith('api/');
      if (OS_FILES.has(d.name)) return [];
      if (d.isDirectory() && underApi) return notGenerated(join(dir, d.name));
      return d.isFile() && (path === 'index.md' || (underApi && path.endsWith('.md'))) ? [] : [path];
    });
  const contentReason = () => {
    if (readdirSync(OUT_DIR).every((name) => OS_FILES.has(name))) return undefined; // empty
    if (!generatedBefore()) return 'it is not empty and was not generated by this script (no index.md with the generated marker)';
    const others = notGenerated();
    const shown = others.slice(0, 5).join(', ') + (others.length > 5 ? `, and ${others.length - 5} more` : '');
    return others.length ? `it holds files not generated by this script (${shown})` : undefined;
  };
  const reason = isInside(LIB_ROOT, OUT_DIR)
    ? 'it is the library folder, or contains it'
    : !existsSync(OUT_DIR)
      ? undefined
      : !statSync(OUT_DIR).isDirectory()
        ? 'it is a file'
        : contentReason();
  if (reason) fail(`Refusing to use --out ${OUT_DIR}: ${reason}. It would be deleted.`);
}

// =============================================================================
// Entry point discovery (ng-packagr)
// =============================================================================
/** Every folder under `dir` that contains an ng-package.json, the library root included. */
function findNgPackageDirs(dir: string): string[] {
  const found = existsSync(join(dir, 'ng-package.json')) ? [dir] : [];
  for (const d of readdirSync(dir, { withFileTypes: true })) {
    const child = join(dir, d.name);
    if (d.isDirectory() && !d.name.startsWith('.') && !SKIP_DIRS.has(d.name) && !SKIP_PATHS.has(child)) {
      found.push(...findNgPackageDirs(child));
    }
  }
  return found;
}

/**
 * Reads the @packageDocumentation block at the top of an entry file, used as the entry point's
 * one-line description in the index:
 *   /** Form fields built on Signal Forms. @packageDocumentation *\/
 */
function entryDescription(file: string): string | undefined {
  const block = /^\s*\/\*\*([\s\S]*?)\*\//.exec(readFileSync(file, 'utf8'))?.[1];
  if (!block || !/@packageDocumentation\b/.test(block)) return undefined;
  const text = block
    .split('\n')
    .map((l) => l.replace(/^\s*\*\s?/, '').replace(/@packageDocumentation\b/, '').trim())
    .filter(Boolean)
    .join('\n');
  return text || undefined;
}

/** Turns each ng-package.json into an EntryPoint. Folders whose entry file is missing are reported and skipped. */
function discoverEntryPoints(): EntryPoint[] {
  const entryPoints: EntryPoint[] = [];
  for (const dir of findNgPackageDirs(LIB_ROOT)) {
    const config = JSON.parse(readFileSync(join(dir, 'ng-package.json'), 'utf8')) as { lib?: { entryFile?: string } };
    const file = resolve(dir, config.lib?.entryFile ?? DEFAULT_ENTRY_FILE);
    const slug = toPosix(relative(LIB_ROOT, dir));
    if (!existsSync(file)) {
      warnings.push(`${slug || '(primary)'}: entry file not found (${toPosix(relative(LIB_ROOT, file))})`);
      continue;
    }
    const importPath = slug ? `${PKG.name}/${slug}` : PKG.name;
    entryPoints.push({ importPath, slug, dir, file, description: entryDescription(file) });
  }
  return entryPoints.sort((a, b) => byName(a.importPath, b.importPath));
}

// =============================================================================
// JSDoc parsing
// =============================================================================
// Our tags.
const DOC_TAGS = ['usage', 'avoid', 'replacedBy', 'replaces', 'example', 'deprecated'];

// One of our tags after text on the same line, as in a one-line JSDoc: `/** Old. @deprecated Use FxNew. */`.
const INLINE_TAG = new RegExp(`\\s+(?=@(?:${DOC_TAGS.join('|')})\\b)`, 'g');

// Angular control flow at the start of a line, in an @example without a code fence: content, not a tag.
const CONTROL_FLOW = /^@(?:(?:if|for|switch|case|default|defer|placeholder|loading|error|empty)\s*[({]|else\b|let\s)/;

// `Old. @deprecated Use FxNew.` → ['Old.', '@deprecated Use FxNew.']. Not at the start of the line
// (an indented tag is content), nor in inline code.
const splitAtInlineTags = (line: string) => {
  const parts: string[] = [];
  let start = 0;
  for (const m of line.matchAll(INLINE_TAG)) {
    const before = line.slice(0, m.index);
    if (!before.trim() || (before.match(/`/g)?.length ?? 0) % 2) continue;
    parts.push(line.slice(start, m.index));
    start = m.index + m[0].length;
  }
  return [...parts, line.slice(start)];
};

/**
 * Splits the raw text of a JSDoc block into its description and its tags.
 *
 * We don't use TypeScript's own tag parsing: it starts a new tag at any `@` after a space, which cuts
 * an @example at its first `@if` or `@for`, and a description at `@Input()`. Here a tag starts only on
 * a line that begins with `@` at column 0, outside a ``` code fence, and not with Angular control flow
 * in an @example. Indented lines are always content. Only our own tags can follow text on a line.
 */
function parseJsDoc(text: string) {
  const description: string[] = [];
  const tags: { name: string; text: string }[] = [];
  let inFence = false;
  for (const raw of text.split('\n')) {
    for (const line of inFence ? [raw] : splitAtInlineTags(raw)) {
      const last = tags.at(-1);
      const content = inFence || (last?.name === 'example' && CONTROL_FLOW.test(line));
      const tag = content ? null : /^@(\w+)\s?(.*)$/.exec(line);
      if (tag) tags.push({ name: tag[1] ?? '', text: tag[2] ?? '' });
      else if (last) last.text += '\n' + line;
      else description.push(line);
      if (line.trimStart().startsWith('```')) inFence = !inFence;
    }
  }
  return { description: description.join('\n').trim(), tags: tags.map((t) => ({ ...t, text: t.text.trim() })) };
}

/**
 * Reads the JSDoc block closest to a node and extracts the description and our custom tags.
 * To support a new tag: add a field to `Doc`, its name to DOC_TAGS, a `case` here, and render it in `header()`.
 */
function readDoc(node: Node): Doc {
  const doc: Doc = { usage: [], avoid: [], replaces: [], examples: [] };
  // For `export const X = ...`, the JSDoc is attached to the statement, not to the declaration.
  const host = Node.isVariableDeclaration(node) ? node.getVariableStatement() : node;
  if (!host || !Node.isJSDocable(host)) return doc;
  const jsDoc = host.getJsDocs().at(-1); // the last block is the one directly above the code
  if (!jsDoc) return doc;

  const { description, tags } = parseJsDoc(jsDoc.getInnerText());
  doc.description = description || undefined;
  for (const { name, text } of tags) {
    switch (name) {
      case 'usage': doc.usage.push(text); break;
      case 'avoid': doc.avoid.push(text); break;
      case 'replacedBy': doc.replacedBy = text; break;
      case 'replaces': doc.replaces.push(text); break;
      case 'deprecated': doc.deprecated = text || 'yes'; break;
      case 'example': doc.examples.push(text); break;
    }
  }
  return doc;
}

// =============================================================================
// Type and signature helpers
// =============================================================================
/**
 * Unwraps the value type of a signal or emitter property:
 * InputSignal<T>, ModelSignal<T>, OutputEmitterRef<T>, EventEmitter<T> → T
 */
function unwrap(t: Type): Type {
  return t.getTypeArguments()[0] ?? t.getAliasTypeArguments()[0] ?? t;
}

type FunctionLike = MethodDeclaration | FunctionDeclaration | ArrowFunction | FunctionExpression;

// For an overloaded function or method, the implementation (it knows every overload).
const implementationOf = <T extends MethodDeclaration | FunctionDeclaration>(fn: T): T =>
  fn.isOverload() ? ((fn.getImplementation() as T | undefined) ?? fn) : fn;

/**
 * JSDoc of a function or method. With overloads, it is usually written on the first overload,
 * not on the implementation: read the implementation's, otherwise the first overload's.
 */
function readFnDoc(fn: MethodDeclaration | FunctionDeclaration): Doc {
  const impl = implementationOf(fn);
  const first = impl.getOverloads()[0];
  return impl.getJsDocs().length || !first ? readDoc(impl) : readDoc(first);
}

/** One readable signature per overload, e.g. `show(message: string, durationMs?: number): void`. */
function signature(name: string, fn: FunctionLike): string[] {
  // Only declarations can have overloads; arrow functions and function expressions have one signature.
  const declared =
    Node.isMethodDeclaration(fn) || Node.isFunctionDeclaration(fn) ? implementationOf(fn).getOverloads() : [];
  const overloads: FunctionLike[] = declared.length ? declared : [fn];
  return overloads.map((s) => {
    // Generic parameters, as written in the source: <T>, <T extends object = {}>
    const generics = s.getTypeParameters().map((t) => t.getText());
    const typeParams = generics.length ? `<${generics.join(', ')}>` : '';
    const params = s.getParameters().map((p) => {
      const rest = p.isRestParameter();
      // A rest parameter is always optional: `...xs?` would be invalid TypeScript.
      const optional = p.isOptional() && !rest ? '?' : '';
      // Prefer the declared type: `x?: string` is printed as `string`, not `string | undefined`.
      const type = p.getTypeNode()?.getType() ?? p.getType();
      return `${rest ? '...' : ''}${p.getName()}${optional}: ${typeText(type, p)}`;
    });
    return `${name}${typeParams}(${params.join(', ')}): ${typeText(s.getReturnType(), s)}`;
  });
}

/** Call signatures of a function type, its type arguments applied: `FxCheck<number>` → `isOdd(value: number): boolean`. */
const callSignatures = (name: string, t: Type, at: Node) =>
  t.getCallSignatures().map((s) => {
    const checker = at.getProject().getTypeChecker().compilerObject;
    return name + checker.signatureToString(s.compilerSignature, at.compilerNode, TYPE_FORMAT);
  });

/**
 * Function assigned to a const: `export const f = (...) => ...` or `export const f = function (...) {...}`.
 * Looks through parentheses and `satisfies`, not `as`: consumers see the asserted type, so `f = (...) as Fn`
 * is documented as `const f: Fn`. Returns undefined for any other initializer.
 */
function functionInitializer(decl: VariableDeclaration): ArrowFunction | FunctionExpression | undefined {
  let init = decl.getInitializer();
  while (init && (Node.isParenthesizedExpression(init) || Node.isSatisfiesExpression(init))) {
    init = init.getExpression();
  }
  return init && (Node.isArrowFunction(init) || Node.isFunctionExpression(init)) ? init : undefined;
}

// =============================================================================
// Angular bindings: inputs, outputs, models
// =============================================================================
// Class member a binding is declared on: a property, or a setter or getter.
const memberOf = (cls: ClassDeclaration, prop: string) =>
  cls.getProperty(prop) ?? cls.getSetAccessor(prop) ?? cls.getGetAccessor(prop);

/**
 * Type of a binding, read from its class member: a setter accepts its parameter's type, a getter gives
 * its return type, a property its own type, unwrapped (InputSignal<T>, EventEmitter<T> → T) when `wrapped`.
 */
function memberType(member: Node | undefined, wrapped: boolean): string {
  if (!member) return 'unknown';
  if (Node.isSetAccessorDeclaration(member)) {
    return typeText(member.getParameters()[0]?.getType() ?? member.getType(), member);
  }
  if (Node.isGetAccessorDeclaration(member)) return typeText(member.getReturnType(), member);
  if (Node.isPropertyDeclaration(member)) return typeText(wrapped ? unwrap(member.getType()) : member.getType(), member);
  return 'unknown';
}

// Description and deprecation of a binding, from the JSDoc of its class member (none if it is missing).
const docOf = (member: Node | undefined) => {
  const doc = member && readDoc(member);
  return { description: doc?.description, deprecated: doc?.deprecated };
};

/**
 * Detects a signal-based binding: `x = input(...)`, `input.required(...)`, `model(...)`, `output(...)`.
 * Returns the function name, whether it is `.required`, and the call node (to read its arguments).
 */
function signalCall(p: PropertyDeclaration) {
  const init = p.getInitializer();
  if (!init || !Node.isCallExpression(init)) return undefined;
  const [fn = '', modifier] = init.getExpression().getText().split('.');
  return SIGNAL_FNS.has(fn) ? { fn, required: modifier === 'required', call: init } : undefined;
}

// Options object of a signal binding: `input(0, { alias, transform })` → `{ alias, transform }`.
const signalOptions = (call: CallExpression) =>
  call
    .getArguments()
    .find((a): a is ObjectLiteralExpression =>
      Node.isObjectLiteralExpression(a) && !!(a.getProperty('alias') || a.getProperty('transform')),
    );

/**
 * Describes a decorator-based input, on a property or on a getter/setter:
 *   @Input() x = 1;   @Input('alias') x;   @Input({ alias, required, transform }) x;
 */
function decoratorInput(
  m: PropertyDeclaration | SetAccessorDeclaration | GetAccessorDeclaration,
  d: Decorator,
): Omit<Member, 'description' | 'deprecated'> {
  const arg = d.getArguments()[0];
  const opts = arg && Node.isObjectLiteralExpression(arg) ? arg : undefined;
  return {
    name: str(arg) ?? str(propOf(opts, 'alias')) ?? m.getName(),
    prop: m.getName(),
    wrapped: false,
    type: memberType(m, false),
    transform: propOf(opts, 'transform')?.getText(),
    required: propOf(opts, 'required')?.getText() === 'true',
    default: Node.isPropertyDeclaration(m) ? m.getInitializer()?.getText() : undefined,
  };
}

/** Collects every template binding of a component or directive: signal-based, decorators, and metadata arrays. */
function bindings(cls: ClassDeclaration, meta: ObjectLiteralExpression | undefined): Bindings {
  const inputs: Member[] = [];
  const outputs: Member[] = [];
  const models: Member[] = [];

  for (const p of cls.getProperties()) {
    // 1. Signal-based: input() / input.required() / model() / output() / outputFromObservable()
    const sig = signalCall(p);
    if (sig) {
      const opts = signalOptions(sig.call);
      const transform = propOf(opts, 'transform')?.getText();
      // The first argument is the default value, unless the binding is required or it's the options object.
      const first = sig.call.getArguments()[0];
      const hasDefault = !sig.required && (sig.fn === 'input' || sig.fn === 'model') && first && first !== opts;
      const member: Member = {
        name: str(propOf(opts, 'alias')) ?? p.getName(),
        prop: p.getName(),
        wrapped: true,
        type: memberType(p, true),
        transform,
        required: sig.required,
        default: hasDefault ? first.getText() : undefined,
        ...docOf(p),
      };
      (sig.fn === 'input' ? inputs : sig.fn === 'model' ? models : outputs).push(member);
      continue;
    }

    // 2. Decorator-based input: @Input()
    const inputDecorator = p.getDecorator('Input');
    if (inputDecorator) {
      inputs.push({ ...decoratorInput(p, inputDecorator), ...docOf(p) });
      continue;
    }

    // 3. Decorator-based output: @Output() x = new EventEmitter<T>()
    const outputDecorator = p.getDecorator('Output');
    if (outputDecorator) {
      outputs.push({
        name: str(outputDecorator.getArguments()[0]) ?? p.getName(),
        prop: p.getName(),
        wrapped: true,
        type: memberType(p, true),
        required: false,
        ...docOf(p),
      });
    }
  }

  // 4. @Input() placed on a setter or a getter
  for (const accessor of [...cls.getSetAccessors(), ...cls.getGetAccessors()]) {
    const d = accessor.getDecorator('Input');
    if (d) inputs.push({ ...decoratorInput(accessor, d), ...docOf(accessor) });
  }

  // 5. Older style, in the decorator metadata: @Component({ inputs: [...], outputs: [...] })
  inputs.push(...metadataBindings(cls, meta, 'inputs'));
  outputs.push(...metadataBindings(cls, meta, 'outputs'));
  return { inputs, outputs, models };
}

/**
 * Own bindings, plus the ones inherited from the `extends` chain, nearest base class first.
 * A member the class (or a nearer base) declares again replaces the inherited one, as in Angular.
 *
 * Inherited types are read through the child's own type, so a generic base is resolved:
 * `class FxDatePicker extends FxFieldBase<Date>` shows `value: Date`, not `value: T`.
 * A base class from another package is read from its .d.ts (see externalBindings). One that can't
 * be resolved stops the walk with a warning: its bindings are not documented.
 */
function allBindings(cls: ClassDeclaration, meta: ObjectLiteralExpression | undefined): Bindings {
  const result = bindings(cls, meta);
  const groups = [result.inputs, result.outputs, result.models] as const;
  const seen = new Set(groups.flatMap((list) => list.map((m) => m.prop)));
  const visited = new Set<ClassDeclaration>([cls]); // guards against a cycle in broken code

  // `extends withHighlight(CardBase)`: ts-morph resolves the base to CardBase, the mixin's argument,
  // and skips the class the mixin declares. CardBase is still read; the mixin's own bindings are not.
  const checkMixin = (c: ClassDeclaration) => {
    const expr = c.getExtends()?.getExpression();
    if (expr && Node.isCallExpression(expr)) {
      warnings.push(`${cls.getName()}: bindings declared by the mixin \`${oneLine(expr.getText())}\` are not documented`);
    }
  };
  checkMixin(cls);

  let base = cls.getBaseClass();
  if (!base && cls.getExtends()) {
    warnings.push(`${cls.getName()}: base class \`${cls.getExtends()?.getText()}\` not resolved, its inputs and outputs are not documented`);
  }
  while (base && !visited.has(base)) {
    visited.add(base);
    checkMixin(base);
    const inherited = base.getSourceFile().isInNodeModules()
      ? (externalBindings(base) ?? { inputs: [], outputs: [], models: [] }) // a plain class has none
      : bindings(base, metadata(ngDecorator(base)));
    [inherited.inputs, inherited.outputs, inherited.models].forEach((list, i) => {
      for (const m of list) {
        if (seen.has(m.prop)) continue; // redeclared lower in the chain
        seen.add(m.prop);
        // Read through the child, so the base's type parameters are resolved (`value: T` → `value: Date`),
        // except for a setter that does not use them: it accepts its parameter's type, already in `m.type`,
        // while the child only gives the getter's.
        const setterType = base?.getSetAccessor(m.prop)?.getParameters()[0]?.getTypeNode();
        const typeParams = new Set(base?.getTypeParameters().map((p) => p.getName()));
        const keepOwn =
          setterType && !setterType.getDescendantsOfKind(SyntaxKind.Identifier).some((id) => typeParams.has(id.getText()));
        const t = keepOwn ? undefined : cls.getType().getProperty(m.prop)?.getTypeAtLocation(cls);
        const type = t ? typeText(m.wrapped ? unwrap(t) : t, cls) : m.type;
        groups[i]?.push({ ...m, type, inheritedFrom: base });
      }
    });
    base = base.getBaseClass();
  }
  return result;
}

/**
 * Bindings declared in the `inputs` or `outputs` array of the decorator metadata:
 *   inputs: ['label', 'size: fxSize', { name: 'value', alias: 'fxValue', required: true, transform: booleanAttribute }]
 * In 'size: fxSize', `size` is the class property and `fxSize` the name used in templates.
 * The type, default value and JSDoc come from the class property of the same name.
 */
function metadataBindings(cls: ClassDeclaration, meta: ObjectLiteralExpression | undefined, key: 'inputs' | 'outputs'): Member[] {
  const list = propOf(meta, key);
  if (!list) return [];
  if (!Node.isArrayLiteralExpression(list)) {
    warnings.push(`${cls.getName()}: \`${key}\` metadata is not an array literal, its bindings are not documented`);
    return [];
  }
  return list.getElements().flatMap((el): Member[] => {
    let prop: string | undefined;
    let alias: string | undefined;
    let required = false;
    let transform: string | undefined;
    const text = str(el);
    if (text !== undefined) {
      [prop, alias] = text.split(':').map((s) => s.trim());
    } else if (Node.isObjectLiteralExpression(el)) {
      prop = str(propOf(el, 'name'));
      alias = str(propOf(el, 'alias'));
      required = propOf(el, 'required')?.getText() === 'true';
      transform = propOf(el, 'transform')?.getText();
    }
    if (!prop) {
      warnings.push(`${cls.getName()}: \`${key}\` entry \`${oneLine(el.getText())}\` not understood, not documented`);
      return [];
    }
    const member = memberOf(cls, prop);
    if (!member) warnings.push(`${cls.getName()}: \`${key}\` entry \`${prop}\` has no matching class property (typo?)`);
    return [
      {
        name: alias || prop,
        prop,
        wrapped: key === 'outputs' && !!member && Node.isPropertyDeclaration(member),
        type: memberType(member, key === 'outputs'), // an output emits T of EventEmitter<T>
        required,
        transform,
        default: key === 'inputs' && member && Node.isPropertyDeclaration(member) ? member.getInitializer()?.getText() : undefined,
        ...docOf(member),
      },
    ];
  });
}

// =============================================================================
// Host directives
// =============================================================================
/** One entry of `hostDirectives`, for the "Host directives" section of the page. */
interface HostDirective {
  name: string;
  decl?: ClassDeclaration | undefined;
  pkg?: string | undefined; // set when the directive comes from another package
  exposed: string[]; // template syntax of what the host exposes: `[hint]`, `(tooltipToggle)`, `[(expanded)]`
}

// Value of a literal type in a .d.ts: "class" → class, true → true.
const literalType = (n?: Node) => {
  if (!n || !Node.isLiteralTypeNode(n)) return undefined;
  const lit = n.getLiteral();
  return Node.isStringLiteral(lit) ? lit.getLiteralText() : lit.getText();
};

/**
 * Bindings of a directive or component from another package. Its decorators are gone from the .d.ts,
 * but the Angular compiler writes them in a static declaration:
 *   static ɵdir: ɵɵDirectiveDeclaration<NgClass, "[ngClass]", never,
 *     { "klass": { "alias": "class"; "required": false; } },   ← inputs (before v16: { "klass": "class" })
 *     { "changed": "ngClassChange" }, ...>                      ← outputs
 * A model appears in both maps: it is recognized by its ModelSignal type.
 */
function externalBindings(cls: ClassDeclaration): Bindings | undefined {
  const declaration = cls.getStaticProperty('ɵdir') ?? cls.getStaticProperty('ɵcmp');
  const typeNode = declaration && Node.isPropertyDeclaration(declaration) ? declaration.getTypeNode() : undefined;
  if (!typeNode || !Node.isTypeReference(typeNode)) return undefined;
  const [, , , inputsNode, outputsNode] = typeNode.getTypeArguments();
  const entries = (n?: Node) =>
    n && Node.isTypeLiteral(n)
      ? n.getProperties().map((p) => ({ prop: str(p.getNameNode()) ?? p.getName(), value: p.getTypeNode() }))
      : [];
  const isModel = (m?: Node) => {
    const t = m && Node.isPropertyDeclaration(m) ? m.getType() : undefined;
    return (t?.getAliasSymbol() ?? t?.getSymbol())?.getName() === 'ModelSignal';
  };
  const result: Bindings = { inputs: [], outputs: [], models: [] };
  const modelNames = new Set<string>();

  for (const { prop, value } of entries(inputsNode)) {
    const member = memberOf(cls, prop);
    const options = value && Node.isTypeLiteral(value) ? value : undefined;
    const option = (name: string) => literalType(options?.getProperty(name)?.getTypeNode());
    const name = options ? (option('alias') ?? prop) : (literalType(value) ?? prop);
    const model = isModel(member);
    if (model) modelNames.add(`${name}Change`);
    (model ? result.models : result.inputs).push({
      name,
      prop,
      wrapped: option('isSignal') === 'true' || model,
      type: memberType(member, option('isSignal') === 'true' || model),
      required: option('required') === 'true',
      ...docOf(member),
    });
  }
  for (const { prop, value } of entries(outputsNode)) {
    const name = literalType(value) ?? prop;
    if (modelNames.has(name)) continue; // the `xChange` half of a model
    const member = memberOf(cls, prop);
    result.outputs.push({ name, prop, wrapped: true, type: memberType(member, true), required: false, ...docOf(member) });
  }
  return result;
}

/** Class a `hostDirectives` entry refers to: `FxTooltip`, or `directive: FxTooltip` in the object form. */
const classOf = (expr: Node) =>
  expr.getType().getSymbol()?.getDeclarations().find((d): d is ClassDeclaration => Node.isClassDeclaration(d));

/**
 * Bindings a class gets from its `hostDirectives`, and the list of those directives.
 *   hostDirectives: [FxRipple, { directive: FxTooltip, inputs: ['fxTooltip: hint'], outputs: ['visibleChange'] }]
 * A bare directive is applied but exposes nothing. In 'fxTooltip: hint', `fxTooltip` is the directive's
 * public name and `hint` the name on the host. A model is two-way on the host only if both halves are
 * exposed with matching names (`value: x` and `valueChange: xChange`); otherwise it is an input or an output.
 * A host directive's own host directives count too (`stack`, the classes read above `cls`, guards against
 * a cycle in broken code).
 */
function hostDirectiveBindings(
  cls: ClassDeclaration,
  meta: ObjectLiteralExpression | undefined,
  stack: Set<ClassDeclaration>,
): { bindings: Bindings; directives: HostDirective[] } {
  const bindings: Bindings = { inputs: [], outputs: [], models: [] };
  const directives: HostDirective[] = [];
  const list = propOf(meta, 'hostDirectives');
  if (!list) return { bindings, directives };
  if (!Node.isArrayLiteralExpression(list)) {
    warnings.push(`${cls.getName()}: \`hostDirectives\` is not an array literal, not documented`);
    return { bindings, directives };
  }
  // 'name' or 'name: alias' → [name, alias]
  const mappings = (n?: Node) =>
    n && Node.isArrayLiteralExpression(n)
      ? n.getElements().flatMap((e) => {
          const [name = '', alias] = (str(e) ?? '').split(':').map((s) => s.trim());
          return name ? [[name, alias || name] as const] : [];
        })
      : [];
  const chain = new Set([...stack, cls]);

  for (const el of list.getElements()) {
    const ref = Node.isObjectLiteralExpression(el) ? propOf(el, 'directive') : el;
    const decl = ref ? classOf(ref) : undefined;
    const name = decl?.getName() ?? ref?.getText() ?? oneLine(el.getText());
    if (!decl) {
      warnings.push(`${cls.getName()}: host directive \`${name}\` not resolved, not documented`);
      continue;
    }
    const pkg = decl.getSourceFile().isInNodeModules() ? packageOf(decl.getSourceFile().getFilePath()) : undefined;
    const own = pkg ? externalBindings(decl) : chain.has(decl) ? undefined : fullBindings(decl, chain);
    if (!own) {
      warnings.push(`${cls.getName()}: bindings of host directive ${name}${pkg ? ` (${pkg})` : ''} could not be read`);
      directives.push({ name, decl, pkg, exposed: [] });
      continue;
    }
    const inputs = mappings(Node.isObjectLiteralExpression(el) ? propOf(el, 'inputs') : undefined);
    const outputs = mappings(Node.isObjectLiteralExpression(el) ? propOf(el, 'outputs') : undefined);
    const exposed: string[] = [];
    // Exposed on the host: renamed, marked with its directive. Its origin on the directive side no longer matters.
    const expose = (m: Member, alias: string, list: Member[], syntax: keyof typeof BINDING_SYNTAX) => {
      list.push({ ...m, name: alias, prop: `${name}.${m.prop}`, inheritedFrom: undefined, fromHostDirective: decl });
      exposed.push(BINDING_SYNTAX[syntax](alias));
    };
    const twoWay = new Set<string>(); // `xChange` outputs already exposed as the second half of a model
    for (const [publicName, alias] of inputs) {
      const input = own.inputs.find((m) => m.name === publicName);
      const model = own.models.find((m) => m.name === publicName);
      const change = outputs.find(([n]) => n === `${publicName}Change`);
      if (input) expose(input, alias, bindings.inputs, 'input');
      else if (model && change?.[1] === `${alias}Change`) {
        expose(model, alias, bindings.models, 'model');
        twoWay.add(change[0]);
      } else if (model) expose(model, alias, bindings.inputs, 'input'); // without its matching output: a plain input
      else warnings.push(`${cls.getName()}: host directive ${name} has no input \`${publicName}\` to expose`);
    }
    for (const [publicName, alias] of outputs) {
      if (twoWay.has(publicName)) continue;
      const output = own.outputs.find((m) => m.name === publicName);
      const model = own.models.find((m) => `${m.name}Change` === publicName);
      if (output) expose(output, alias, bindings.outputs, 'output');
      // The `xChange` half of a model alone: an output, so no default, required flag or transform.
      else if (model) expose({ ...model, default: undefined, required: false, transform: undefined }, alias, bindings.outputs, 'output');
      else warnings.push(`${cls.getName()}: host directive ${name} has no output \`${publicName}\` to expose`);
    }
    directives.push({ name, decl, pkg, exposed });
  }
  return { bindings, directives };
}

/**
 * Everything a class offers to templates: own and inherited bindings, then those exposed by its host
 * directives, and the list of those directives.
 */
function fullBindings(cls: ClassDeclaration, stack = new Set<ClassDeclaration>()): Bindings & { directives: HostDirective[] } {
  const meta = metadata(ngDecorator(cls));
  const own = allBindings(cls, meta);
  const host = hostDirectiveBindings(cls, meta, stack);
  return {
    inputs: [...own.inputs, ...host.bindings.inputs],
    outputs: [...own.outputs, ...host.bindings.outputs],
    models: [...own.models, ...host.bindings.models],
    directives: host.directives,
  };
}

/**
 * Lists the content projection slots of a component by scanning its template for <ng-content>.
 * Reads the inline `template` or the `templateUrl` file. A slot without `select` is reported as "default", listed first.
 */
function slots(cls: ClassDeclaration, meta?: ObjectLiteralExpression): string[] {
  let html = str(propOf(meta, 'template'));
  const url = str(propOf(meta, 'templateUrl'));
  if (!html && url) {
    const file = resolve(dirname(cls.getSourceFile().getFilePath()), url);
    if (existsSync(file)) html = readFileSync(file, 'utf8');
  }
  if (!html) return [];
  html = html.replace(/<!--[\s\S]*?-->/g, ''); // a commented-out <ng-content> is not a slot
  const found = [...html.matchAll(/<ng-content\b([^>]*)>/g)].map(
    (m) => /select\s*=\s*["']([^"']+)["']/.exec(m[1] ?? '')?.[1] ?? 'default',
  );
  // "default" first, the named slots keep their template order (sort is stable)
  return [...new Set(found)].sort((a, b) => Number(b === 'default') - Number(a === 'default'));
}

// =============================================================================
// Markdown rendering — change the wording or layout of the generated files here
// =============================================================================
/** Top of every symbol page: title, import line(s), warnings, description, @usage and @avoid. */
function header(name: string, kind: Kind, doc: Doc, ctx: Context, extra: string[] = []): string[] {
  const lines = [`# ${name} (${kind})`, '', `\`import { ${name} } from '${ctx.ep.importPath}';\``];
  const alsoFrom = ctx.alsoFrom.map((x) => `\`${x.importPath}\`` + (x.name === name ? '' : ` as \`${x.name}\``));
  if (alsoFrom.length) lines.push('', `Also exported from: ${alsoFrom.join(', ')}`);
  lines.push(...extra.flatMap((x) => ['', x]));
  if (doc.deprecated) lines.push('', `> ⚠️ Deprecated: ${doc.deprecated}`);
  if (doc.replacedBy) lines.push('', `> ⚠️ For new code, use instead: ${doc.replacedBy}`);
  if (doc.replaces.length) lines.push('', `Replaces: ${doc.replaces.join(', ')}`);
  if (doc.description) lines.push('', doc.description);
  if (doc.usage.length) lines.push('', '## When to use', ...doc.usage.map((u) => `- ${u}`));
  if (doc.avoid.length) lines.push('', '## When not to use', ...doc.avoid.map((a) => `- ${a}`));
  return lines;
}

// Binding syntax used as the name of each list item: what the agent writes in the template.
const BINDING_SYNTAX = {
  input: (name: string) => `[${name}]`,
  model: (name: string) => `[(${name})]`,
  output: (name: string) => `(${name})`,
};

/**
 * One list item per binding, every fact labeled where it appears (no table: the agent reads raw
 * Markdown, where a table needs `\|` escapes and column counting, and empty cells waste tokens):
 *   - `[aria-label]: string` **required** — Accessible label.
 *   - `[loading]: boolean` = `false` · transform: booleanAttribute — Shows a spinner.
 *   - `[kind]: Variant | undefined` ⚠️ deprecated: Use `variant`. — Old name of `variant`.
 * Missing facts are left out.
 */
function memberList(title: string, binding: keyof typeof BINDING_SYNTAX, list: Member[], note?: string): string[] {
  if (!list.length) return [];
  const items = list.map(
    (m) =>
      `- ${code(`${BINDING_SYNTAX[binding](m.name)}: ${m.type}`)}` +
      (m.required ? ' **required**' : '') +
      (m.default ? ` = ${code(m.default)}` : '') +
      (m.transform ? ` · transform: ${m.transform}` : '') +
      (m.inheritedFrom ? ` · inherited from ${m.inheritedFrom.getName()}` : '') +
      (m.fromHostDirective ? ` · from host directive ${m.fromHostDirective.getName()}` : '') +
      (m.deprecated ? ` ⚠️ deprecated: ${oneLine(m.deprecated)}` : '') +
      (m.description ? ` — ${oneLine(m.description)}` : ''),
  );
  return ['', `## ${title}`, ...(note ? [note, ''] : []), ...items];
}

/**
 * One host directive, linked to its page when the library documents it:
 *   - [FxTooltip](../../overlay/FxTooltip.md): exposes `[hint]`, `(tooltipToggle)`
 *   - NgStyle (`@angular/common`): exposes `[panelStyle]`
 */
function hostDirectiveLine(d: HostDirective, fromPage: string): string {
  const target = d.decl && owners.get(d.decl)?.ctx.page;
  const label = d.pkg
    ? `${d.name} (\`${d.pkg}\`)`
    : target
      ? `[${d.name}](${posix.relative(posix.dirname(fromPage), target)})`
      : `${d.name} (not exported by the library)`;
  return `- ${label}: exposes ${d.exposed.length ? d.exposed.map(code).join(', ') : 'nothing'}`;
}

// An @example without a code fence is assumed to be an HTML template snippet.
const examples = (doc: Doc) =>
  doc.examples.length
    ? ['', '## Examples', ...doc.examples.map((x) => (x.includes('```') ? x : codeBlock('html', x)))]
    : [];

// =============================================================================
// Symbol description — one function per kind of export
// =============================================================================
/** Classes: components, directives, pipes, services, or plain classes, based on their Angular decorator. */
function describeClass(name: string, kind: Kind, cls: ClassDeclaration, ctx: Context): Entry {
  const doc = readDoc(cls);
  const meta = metadata(ngDecorator(cls));
  const lines: string[] = [];
  let selector: string | undefined;
  let pipeName: string | undefined;

  if (kind === 'component' || kind === 'directive') {
    // --- Components and directives: selector, bindings, slots, documented public methods
    selector = str(propOf(meta, 'selector'));
    const exportAs = str(propOf(meta, 'exportAs'));
    const { inputs, outputs, models, directives } = fullBindings(cls);
    // No selector: a directive is an abstract base class (`@Directive()`), only meant to be extended;
    // a component is created from code (a route, a dialog).
    const selectorLine = selector
      ? `Selector: \`${selector}\`${exportAs ? ` · exportAs: \`${exportAs}\`` : ''}`
      : kind === 'directive'
        ? 'No selector: base class, extend it instead of using it in a template.'
        : 'No selector: not used in a template, created from code (a route, a dialog, `ViewContainerRef.createComponent()`).';
    lines.push(...header(name, kind, doc, ctx, [selectorLine]));
    lines.push(...memberList('Inputs', 'input', inputs));
    lines.push(...memberList('Outputs', 'output', outputs));
    lines.push(...memberList('Two-way bindings (model)', 'model', models, 'Each one also works as `[name]` + `(nameChange)`.'));
    if (directives.length) {
      lines.push(
        '',
        '## Host directives',
        'Applied to every instance. Only the bindings listed here can be used in templates.',
        '',
        ...directives.map((d) => hostDirectiveLine(d, ctx.page)),
      );
    }
    if (kind === 'component') {
      const s = slots(cls, meta);
      if (s.length) lines.push('', '## Content projection (ng-content)', ...s.map((x) => `- \`${x}\``));
    }
    // Only methods WITH a JSDoc description: undocumented public methods are usually template handlers.
    const methods = cls
      .getMethods()
      .filter((m) => isPublic(m) && !LIFECYCLE.test(m.getName()))
      .flatMap((m) => {
        const d = readFnDoc(m).description;
        return d ? signature(m.getName(), m).map((s) => `- ${code(s)} — ${firstParagraph(d)}`) : [];
      });
    if (methods.length) lines.push('', '## Public methods (via viewChild or exportAs)', ...methods);

    // Documentation completeness checks (fail the run in --strict mode). The class description is
    // checked with the page. An inherited or exposed binding is reported on the page of the class that
    // declares it, or here if that class has no page (not exported). Another package's docs are not checked.
    const undocumented = (list: Member[], what: string) => {
      for (const m of list) {
        const origin = m.fromHostDirective ?? m.inheritedFrom;
        if (m.description || (origin && (owners.has(origin) || origin.getSourceFile().isInNodeModules()))) continue;
        warnings.push(`${name}.${m.name}: undocumented ${what}${origin ? ` (declared by ${origin.getName()})` : ''}`);
      }
    };
    undocumented(inputs.concat(models), 'input');
    undocumented(outputs, 'output');
  } else if (kind === 'pipe') {
    // --- Pipes: template name and transform() signature
    pipeName = str(propOf(meta, 'name'));
    lines.push(...header(name, kind, doc, ctx, [`Template usage: \`{{ value | ${pipeName} }}\``]));
    const transform = cls.getMethod('transform');
    if (transform) lines.push('', '## Signature', codeBlock('ts', signature('transform', transform).join('\n')));
  } else {
    // --- Services and plain classes: all public properties and methods
    const providedIn = propOf(meta, 'providedIn')?.getText();
    lines.push(...header(name, kind, doc, ctx, providedIn ? [`providedIn: ${providedIn}`] : []));
    const props = [...cls.getProperties(), ...cls.getGetAccessors()].filter(isPublic).map((p) => {
      const readonly = Node.isPropertyDeclaration(p) && p.isReadonly() ? 'readonly ' : '';
      const type = Node.isGetAccessorDeclaration(p) ? p.getReturnType() : p.getType();
      const d = readDoc(p).description;
      if (!d) warnings.push(`${name}.${p.getName()}: undocumented property`);
      return `- ${code(`${readonly}${p.getName()}: ${typeText(type, p)}`)}${d ? ` — ${firstParagraph(d)}` : ''}`;
    });
    // Public parameter properties: `constructor(public readonly http: HttpClient)` declares a property too.
    // `readonly` alone also makes a public one.
    const ctorProps = (cls.getConstructors()[0]?.getParameters() ?? [])
      .filter((p) => p.isParameterProperty() && p.getScope() === Scope.Public)
      .map((p) => `- ${code(`${p.isReadonly() ? 'readonly ' : ''}${p.getName()}: ${typeText(p.getType(), p)}`)} — constructor parameter`);
    props.push(...ctorProps);
    const methods = cls
      .getMethods()
      .filter((m) => isPublic(m) && !LIFECYCLE.test(m.getName()))
      .flatMap((m) => {
        const d = readFnDoc(m).description;
        if (!d) warnings.push(`${name}.${m.getName()}: undocumented method`);
        return signature(m.getName(), m).map((s) => `- ${code(s)}${d ? ` — ${firstParagraph(d)}` : ''}`);
      });
    if (props.length) lines.push('', '## Properties', ...props);
    if (methods.length) lines.push('', '## Methods', ...methods);
  }

  lines.push(...examples(doc));
  return { name, kind, doc, ep: ctx.ep, page: ctx.page, selector, pipeName, markdown: lines.join('\n') };
}

/** Package that declares a file of node_modules: `.../node_modules/@angular/core/index.d.ts` → `@angular/core`. */
const packageOf = (file: string) =>
  [...toPosix(file).matchAll(/\/node_modules\/((?:@[^/]+\/)?[^/]+)\//g)].at(-1)?.[1] ?? 'another package';

/**
 * Kind of an exported declaration, undefined for the ones not documented (namespaces, etc.).
 * Decorators are gone from a .d.ts of another package: there, Angular classes are recognized by the
 * static declaration the compiler adds (ɵcmp, ɵdir, ɵpipe, ɵprov).
 */
function kindOf(decl: Node): Kind | undefined {
  if (Node.isClassDeclaration(decl)) {
    if (!decl.getSourceFile().isInNodeModules()) return NG_DECORATORS[ngDecorator(decl)?.getName() ?? ''] ?? 'class';
    const has = (p: string) => !!decl.getStaticProperty(p);
    return has('ɵcmp') ? 'component' : has('ɵdir') ? 'directive' : has('ɵpipe') ? 'pipe' : has('ɵprov') ? 'service' : 'class';
  }
  if (Node.isInterfaceDeclaration(decl)) return 'interface';
  if (Node.isTypeAliasDeclaration(decl)) return 'type';
  if (Node.isEnumDeclaration(decl)) return 'enum';
  if (Node.isFunctionDeclaration(decl)) return 'function';
  // `export const f = () => ...` is a function for the consumer: documented and indexed as one.
  if (Node.isVariableDeclaration(decl)) return functionInitializer(decl) ? 'function' : 'const';
  return undefined;
}

/**
 * A symbol the library re-exports from another package (`export { booleanAttribute } from '@angular/core'`).
 * Short page: the import path to use, and where the full documentation lives. Its own JSDoc is not
 * copied: it belongs to the other package and can be long.
 */
function describeExternal(name: string, kind: Kind, decl: Node, ctx: Context): Entry {
  const pkg = packageOf(decl.getSourceFile().getFilePath());
  const doc: Doc = { usage: [], avoid: [], replaces: [], examples: [], description: `Re-exported from \`${pkg}\`.` };
  const markdown = [...header(name, kind, doc, ctx), '', `See the documentation of \`${pkg}\` for its API.`].join('\n');
  return { name, kind, doc, ep: ctx.ep, page: ctx.page, markdown };
}

/**
 * Named type the consumer cannot look up: an alias or interface of the library that has no page.
 * `const isOdd: FxCheck<number>` alone does not tell how to call `isOdd`.
 */
function isHidden(t: Type): boolean {
  const decls = (t.getAliasSymbol() ?? t.getSymbol())
    ?.getDeclarations()
    .filter((d) => Node.isTypeAliasDeclaration(d) || Node.isInterfaceDeclaration(d)) ?? []; // not an inline type
  return decls.length > 0 && !decls.some((d) => owners.has(d) || d.getSourceFile().isInNodeModules());
}

/** Any exported declaration. Non-class symbols are shown as their source or signature in a code block. */
function describe(name: string, decl: Node, ctx: Context): Entry | undefined {
  const kind = kindOf(decl);
  if (!kind) return undefined;
  if (decl.getSourceFile().isInNodeModules()) return describeExternal(name, kind, decl, ctx);
  if (Node.isClassDeclaration(decl)) return describeClass(name, kind, decl, ctx);

  const doc = Node.isFunctionDeclaration(decl) ? readFnDoc(decl) : readDoc(decl);
  let body: string;
  if (Node.isFunctionDeclaration(decl)) body = signature(name, decl).join('\n');
  else if (Node.isVariableDeclaration(decl)) {
    // A function typed on its variable (`authGuard: CanActivateFn = ...`) keeps that type, as in the .d.ts:
    // the alias name tells what the function is for, and the arrow's inferred signature can be narrower.
    const fn = functionInitializer(decl);
    const typed = !!decl.getTypeNode();
    body = fn && !typed ? signature(name, fn).join('\n') : `const ${name}: ${typeText(decl.getType(), decl)};`;
    if (fn && typed && isHidden(decl.getType())) body += '\n' + callSignatures(name, decl.getType(), decl).join('\n');
  } else body = decl.getText(); // interface, type alias, enum

  const markdown = [...header(name, kind, doc, ctx), '', codeBlock('ts', body), ...examples(doc)].join('\n');
  return { name, kind, doc, ep: ctx.ep, page: ctx.page, markdown };
}

// =============================================================================
// Main 1: load the library
// =============================================================================
checkOutDir();
const entryPoints = discoverEntryPoints();
if (!entryPoints.length) fail(`No ng-package.json with an existing entry file found under ${LIB_ROOT}`);
if (!existsSync(TSCONFIG)) fail(`${TSCONFIG} not found: pass --tsconfig <file>.`);

// Map every import path to its entry file, so imports between entry points
// (e.g. `@acme/ui/core` used in `forms`) resolve to the sources, not to a dist/ build.
const tsconfig = getCompilerOptionsFromTsConfig(TSCONFIG).options;
const paths = { ...tsconfig.paths, ...Object.fromEntries(entryPoints.map((ep) => [ep.importPath, [ep.file]])) };
const project = new Project({ tsConfigFilePath: TSCONFIG, compilerOptions: { paths } });

// =============================================================================
// Main 2: collect exports and assign each declaration to one owner entry point
// =============================================================================
// The same declaration can be exported by several entry points (re-exports), and under several names
// (`export { A as B }`). It is documented once, under its owner: the entry point whose folder contains
// its source file.
const exported = new Map<Node, { ep: EntryPoint; name: string }[]>();
for (const ep of entryPoints) {
  const sourceFile = project.getSourceFile(ep.file) ?? project.addSourceFileAtPath(ep.file);
  // getExportedDeclarations() follows `export * from` chains: we get exactly the public API.
  for (const [name, decls] of sourceFile.getExportedDeclarations()) {
    // Every exported name gets a page or a warning: nothing disappears silently.
    if (name === 'default') {
      warnings.push(`${ep.importPath}: default export not documented, export it by name`);
      continue;
    }
    if (!decls.length) {
      warnings.push(`${ep.importPath}: export \`${name}\` could not be resolved, not documented`);
      continue;
    }
    // An overloaded function is exported once per signature: keep one declaration, the implementation
    // if there is one (a .d.ts has only overloads).
    const fns = decls.filter(Node.isFunctionDeclaration);
    const keptFn = fns.find((f) => !f.isOverload()) ?? fns[0];
    for (const decl of decls) {
      if (Node.isFunctionDeclaration(decl) && decl !== keptFn) continue;
      exported.set(decl, [...(exported.get(decl) ?? []), { ep, name }]);
    }
  }
}

// Owner of each declaration: the deepest exporting entry point containing its file, otherwise the
// first one that exports it. The page takes the name the owner exports it under, the declaration's own
// name if it is one of them (`export { A, A as B }` → A); its other exports are listed on the page.
// Computed for all of them first, so a page can link to another one.
const owned = [...exported].map(([decl, exports]) => {
  const file = resolve(decl.getSourceFile().getFilePath()); // ts-morph paths use `/`, ep.dir the OS separator
  const eps = [...new Set(exports.map((x) => x.ep))];
  const owner =
    eps.filter((ep) => isInside(file, ep.dir)).sort((a, b) => b.dir.length - a.dir.length)[0] ?? eps[0]!; // eps is never empty
  const ownNames = exports.filter((x) => x.ep === owner).map((x) => x.name);
  const declName = Node.hasName(decl) ? decl.getName() : undefined;
  const name = ownNames.find((n) => n === declName) ?? ownNames[0]!;
  const alsoFrom = exports
    .filter((x) => x.ep !== owner || x.name !== name)
    .map((x) => ({ importPath: x.ep.importPath, name: x.name }));
  return { decl, name, ep: owner, alsoFrom };
});

// Page of each symbol, relative to OUT_DIR. Names that differ only by case (`FxSize`, `fxSize`) would
// share one file on a case-insensitive file system (macOS, Windows), where the package may be unpacked:
// the first in code point order keeps `<Name>.md`, the next ones get `<Name>-2.md`, `-3`… (no name has a `-`).
const pageOf = new Map<string, string>(); // docPath → page
const sharing = new Map<string, number>(); // lowercased docPath → number of pages using it so far
for (const path of [...new Set(owned.map(docPath))].sort()) {
  const n = (sharing.get(path.toLowerCase()) ?? 0) + 1;
  sharing.set(path.toLowerCase(), n);
  pageOf.set(path, n === 1 ? path : path.replace(/\.md$/, `-${n}.md`));
}
// Also read while pages are described: to link a host directive's page, and to know which classes have one.
const owners = new Map<Node, { name: string; ctx: Context }>(
  owned.map(({ decl, name, ep, alsoFrom }) => [decl, { name, ctx: { ep, alsoFrom, page: pageOf.get(docPath({ name, ep }))! } }]),
);

const byFile = new Map<string, Entry[]>(); // doc file path → described declarations
for (const [decl, { name, ctx }] of owners) {
  const owner = ctx.ep;
  const entry = describe(name, decl, ctx);
  if (!entry) {
    warnings.push(
      Node.isSourceFile(decl)
        ? `${owner.importPath}: namespace re-export \`${name}\` (export * as ${name}) not documented, export its members by name`
        : `${owner.importPath}: export \`${name}\` (${decl.getKindName()}) not supported, not documented`,
    );
    continue;
  }
  byFile.set(entry.page, [...(byFile.get(entry.page) ?? []), entry]);
}

// One name can cover several declarations (e.g. an interface and a const): merge them into one file.
const entries: Entry[] = [...byFile.values()].map((list) => {
  const first = list[0]!; // each list has at least one entry
  // Documentation completeness check (fails the run in --strict mode): one description per page is enough.
  if (!list.some((e) => e.doc.description)) warnings.push(`${first.name}: missing JSDoc description`);
  return { ...first, markdown: list.map((e) => e.markdown).join('\n\n---\n\n') };
});
entries.sort((a, b) => byName(a.name, b.name));

// =============================================================================
// Main 3: write one file per symbol (full regeneration)
// =============================================================================
// Removed or renamed symbols must not leave stale files behind.
rmSync(OUT_DIR, { recursive: true, force: true });
mkdirSync(OUT_DIR, { recursive: true }); // for index.md, even when no symbol gets a page
for (const e of entries) {
  const file = join(OUT_DIR, e.page);
  mkdirSync(dirname(file), { recursive: true });
  writeFileSync(file, e.markdown + '\n');
}

// =============================================================================
// Main 4: write the index — one section per entry point, then one sub-section per kind
// =============================================================================
const GROUPS: [Kind[], string][] = [
  [['component'], 'Components'],
  [['directive'], 'Directives'],
  [['pipe'], 'Pipes'],
  [['service'], 'Services'],
  [['interface', 'type', 'enum'], 'Types'],
  [['function', 'const', 'class'], 'Functions, constants and classes'],
];

// Index line: link, selector or pipe name, first sentence of the description, replacement hints.
const indexLine = (e: Entry) =>
  `- [${e.name}](${e.page})` +
  (e.selector ? ` \`${e.selector}\`` : '') +
  (e.pipeName ? ` \`| ${e.pipeName}\`` : '') +
  (e.doc.description ? ` — ${summary(e.doc.description)}` : '') +
  (e.doc.replaces.length ? ` (replaces ${e.doc.replaces.join(', ')})` : '') +
  (e.doc.replacedBy ? ` → ⚠️ prefer ${e.doc.replacedBy}` : '') +
  (e.doc.deprecated ? ' (deprecated)' : '');

const entryPointSection = (ep: EntryPoint) => {
  const own = entries.filter((e) => e.ep === ep);
  if (!own.length) return []; // e.g. an empty primary entry point
  return [
    '',
    `## \`${ep.importPath}\`${ep.description ? ` — ${summary(ep.description)}` : ''}`,
    ...GROUPS.flatMap(([kinds, title]) => {
      const list = own.filter((e) => kinds.includes(e.kind));
      return list.length ? ['', `### ${title}`, ...list.map(indexLine)] : [];
    }),
  ];
};

// The intro lines are instructions for the agent reading the index: add yours with --note.
const index = [
  `# ${PKG.name} ${PKG.version} — Public API`,
  '',
  GENERATED_MARKER,
  '',
  ...NOTES,
  'Read this index, then only the relevant `api/.../<Symbol>.md` file.',
  'Import each symbol from the entry point given in its section heading.',
  ...entryPoints.flatMap(entryPointSection),
].join('\n');
writeFileSync(join(OUT_DIR, 'index.md'), index + '\n');

// =============================================================================
// Report
// =============================================================================
console.log(`agent-docs: ${entries.length} symbols from ${entryPoints.length} entry point(s) → ${OUT_DIR}`);
if (warnings.length) {
  // A base class is read once per subclass: its warnings would repeat.
  const unique = [...new Set(warnings)];
  console.warn(`\n${unique.length} warning(s):\n` + unique.map((w) => `  - ${w}`).join('\n'));
  if (STRICT) process.exit(1);
}
